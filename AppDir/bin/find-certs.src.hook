#!/bin/sh

# Tell ladybird the location of the host certificates with a flag
# when they are not located in /etc/ssl/certs/ca-certificates.crt
if [ ! -f /etc/ssl/certs/ca-certificates.crt ]; then
	# do not do this if the --certificate flag was already given
	for i do case "$i" in
		--certificate|-C) _do_not_search_certs=1; break;;
	esac; done

	if [ "$_do_not_search_certs" != 1 ]; then
		_possible_certs="
		  /etc/pki/tls/cert.pem
		  /etc/pki/tls/cacert.pem
		  /etc/ssl/cert.pem
		  /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
		  /var/lib/ca-certificates/ca-bundle.pem
		"
		for c in $_possible_certs; do
			if [ -f "$c" ]; then
				set -- --certificate "$c" "$@"
				break
			fi
		done
	fi
fi

# Point fontconfig to bundled configuration if available inside AppDir
if [ -d "${APPDIR:-}/etc/fonts" ]; then
	export FONTCONFIG_PATH="${APPDIR}/etc/fonts"
	[ -f "${APPDIR}/etc/fonts/fonts.conf" ] && export FONTCONFIG_FILE="${APPDIR}/etc/fonts/fonts.conf"
fi
